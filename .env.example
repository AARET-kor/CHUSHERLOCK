# Local SQLite database file used for the scaffold phase.
CODEX_DB_PATH=./data/codex.sqlite

# Required for AI auto-classification (/ingest). Get one at
# https://platform.claude.com — or leave unset and log in with `ant auth login`.
# ANTHROPIC_API_KEY=

# Override the classification model (default: claude-opus-4-8).
# CODEX_AI_MODEL=claude-opus-4-8

# Set to "fake" to run the ingest flow offline with deterministic fake
# suggestions (no API calls) — useful for trying the UI without a key.
# CODEX_AI_MODE=fake

# Light model for mechanical subtasks (OCR transcription, relatedness
# screening) — default claude-haiku-4-5, ~1/5 the per-token price.
# CODEX_AI_MODEL_LIGHT=claude-haiku-4-5

# Mid-tier model for structured judgement (figure bbox detection, learning
# clusters) — default claude-sonnet-5, cheaper than Opus, sharper than Haiku.
# CODEX_AI_MODEL_MID=claude-sonnet-5

# Max upload size in MB (default 100). Text PDFs/Word extract locally, so
# large text docs are cheap; scanned PDFs are segmented for OCR regardless.
# CODEX_MAX_UPLOAD_MB=100
