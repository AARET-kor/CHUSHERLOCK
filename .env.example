# Local SQLite database file used for the scaffold phase.
CODEX_DB_PATH=./data/codex.sqlite

# Required for AI auto-classification (/ingest). Get one at
# https://platform.claude.com — or leave unset and log in with `ant auth login`.
# ANTHROPIC_API_KEY=

# Override the classification model (default: claude-opus-5-5).
# CODEX_AI_MODEL=claude-opus-5-5

# Set to "fake" to run the ingest flow offline with deterministic fake
# suggestions (no API calls) — useful for trying the UI without a key.
# CODEX_AI_MODE=fake

# Light model for mechanical subtasks (OCR transcription, relatedness
# screening, BBIP case parsing) — default claude-haiku-5-5, ~1/5 the
# per-token price.
# CODEX_AI_MODEL_LIGHT=claude-haiku-5-5

# Mid-tier model for structured judgement (figure bbox detection, learning
# clusters, BBIP practice/business sections) — default claude-sonnet-5-5,
# cheaper than Opus, sharper than Haiku.
# CODEX_AI_MODEL_MID=claude-sonnet-5-5

# Max upload size in MB (default 100). Text PDFs/Word extract locally, so
# large text docs are cheap; scanned PDFs are segmented for OCR regardless.
# CODEX_MAX_UPLOAD_MB=100

# BBIP brief (⚡ 핵심 브리핑) — defaults to CODEX_AI_MODEL at low effort.
# BBIP_BRIEF_MODEL=claude-opus-5-5
# BBIP_BRIEF_EFFORT=low
# BBIP 🔬 문헌 근거 (button-triggered only).
# NCBI_API_KEY=            # optional: PubMed 10 req/s instead of 3
# BBIP_WEB_DOMAINS=pubmed.ncbi.nlm.nih.gov,fda.gov   # optional: override the web allow-list
# BBIP_WEB_MODEL=claude-sonnet-5-5                    # optional: web search model (default CODEX_AI_MODEL_MID)
# Opus 5.x / Sonnet 5.5 BBIP calls opt into the server-side refusal fallback
# ("default" form — the API picks the fallback model); nothing to configure.
